# Ryu OpenFlow 1.3 Controller with Statistical DDoS Detection & Automatic Mitigation
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install specific compatible eventlet and dnspython for Ryu 4.34
RUN pip install --no-cache-dir \
    eventlet==0.30.2 \
    dnspython==2.2.1 \
    ryu==4.34

# Patch eventlet compatibility if needed
RUN sed -i 's/from eventlet.wsgi import ALREADY_HANDLED/ALREADY_HANDLED = b""/' /usr/local/lib/python3.10/site-packages/ryu/app/wsgi.py || true

COPY controller/ /app/controller/
COPY detection/ /app/detection/
COPY mitigation/ /app/mitigation/

EXPOSE 6653

ENV PYTHONPATH=/app

CMD ["ryu-manager", "--ofp-tcp-listen-port", "6653", \
     "controller/simple_switch_controller.py", \
     "controller/monitor.py", \
     "detection/ddos_detector.py", \
     "mitigation/mitigation_engine.py"]

